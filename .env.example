# Copia este archivo como .env.local en cada app y completa los valores.
# Nunca subas el archivo con valores al repositorio.

# Mapa base (MapTiler u otro proveedor). Restringe la clave por dominio en el panel del proveedor.
VITE_MAPA_ESTILO_URL=

# Buscador de direcciones (Nominatim/Photon propio o de un proveedor). Vacío: servicio público de OpenStreetMap,
# solo para la demo (máx. 1 consulta por segundo). «ninguno» lo desactiva y el punto se marca en el mapa.
VITE_GEOCODIFICADOR_URL=

# Google Maps para crear y despachar procedimientos (Maps JavaScript API, Places API (New) y Geocoding API).
# Restringe la clave por dominio (referentes HTTP) y por API en Google Cloud, y pon una alerta de presupuesto.
# Vacío: la demo usa el mapa y el buscador propios y avisa que falta configurar Google Maps.
VITE_GOOGLE_MAPS_KEY=
# Map ID del estilo (Google Cloud → Map Management). Vacío: DEMO_MAP_ID (solo pruebas).
VITE_GOOGLE_MAPS_MAP_ID=

# Supabase (cuando exista el proyecto). Solo la clave pública "anon"; nunca la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
