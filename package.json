{
  "name": "plataforma-seguridad-publica",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de Seguridad Pública: Halcones, Georreferenciado y Análisis de eventos",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:halcones": "npm run dev -w @plataforma/halcones",
    "dev:georreferenciado": "npm run dev -w @plataforma/georreferenciado",
    "dev:analisis": "npm run dev -w @plataforma/analisis",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node scripts/servir-demo.mjs",
    "test": "vitest run",
    "test:e2e": "pytest pruebas/e2e -q"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
